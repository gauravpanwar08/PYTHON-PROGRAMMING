# =======================================
# Python-Backend / FastAPI/Flask/Django
# =======================================

__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
*$py.class

# Virtual environments (ALL patterns)
.fastapi-venv/
venv/
.venv/
*venv/
**/venv/
**/.venv/
**/*venv/
env/
ENV/
*env/
**/*env/

# Environment variables (secrets)
.env
.env.*
!.env.example
secrets.json

# Logs
*.log

# Alembic (keep migrations, ignore cache)
alembic/versions/__pycache__/

instance/
.webassets-cache/

# Database files (local / SQLite)
*.sqlite3
*.db
db.sqlite3
db.sqlite3-journal

# Django generated folders (Safe for FastAPI too)
staticfiles/
media/
*.cache
**/migrations/__pycache__/

# =========================
#      Frontend
# =========================

node_modules/
dist/
build/

npm-debug.log*
yarn-debug.log*
yarn-error.log*

